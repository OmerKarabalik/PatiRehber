default_platform(:ios)

platform :ios do
  desc "Fetch certificates and profiles using App Store Connect API Key"
  lane :prepare_signing do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    get_certificates(
      api_key: api_key,
      development: false,
      keychain_path: ENV["KEYCHAIN_PATH"],
      keychain_password: ENV["KEYCHAIN_PASSWORD"]
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.patirehber.patiRehber",
      development: false
    )
  end

  desc "Build IPA and upload to App Store Connect / TestFlight"
  lane :build_and_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      keychain_path: ENV["KEYCHAIN_PATH"],
      keychain_password: ENV["KEYCHAIN_PASSWORD"],
      output_directory: "../build/ios/ipa",
      output_name: "PatiRehber.ipa",
      clean: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/ios/ipa/PatiRehber.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
