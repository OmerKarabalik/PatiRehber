default_platform(:ios)

platform :ios do
  desc "Fetch certificates/profiles, install profile, update code signing, build IPA and upload to TestFlight"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    get_certificates(
      api_key: api_key,
      development: false,
      keychain_path: ENV["KEYCHAIN_PATH"],
      keychain_password: ENV["KEYCHAIN_PASSWORD"]
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.patirehber.patiRehber",
      development: false
    )

    profile_path = ENV["SIGH_PROFILE_PATH"]
    profile_uuid = ENV["SIGH_UUID"]
    profile_name = ENV["SIGH_NAME"]

    sh("mkdir -p ~/Library/MobileDevice/Provisioning\\ Profiles")
    sh("cp \"#{profile_path}\" \"$HOME/Library/MobileDevice/Provisioning Profiles/#{profile_uuid}.mobileprovision\"")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "com.patirehber.patiRehber"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "PatiRehber.ipa",
      clean: false,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.patirehber.patiRehber" => profile_uuid
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/ios/ipa/PatiRehber.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
