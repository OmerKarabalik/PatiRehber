default_platform(:ios)

platform :ios do
  desc "Fetch certificates/profiles, install profile, update code signing, build IPA and upload to TestFlight"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    # 1. Automatically clean up any orphaned distribution certificates via App Store Connect API
    UI.message("Checking for orphaned distribution certificates...")
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    certs = Spaceship::ConnectAPI::Certificate.all
    certs.each do |cert|
      type = cert.certificate_type.to_s.upcase
      if type == "DISTRIBUTION" || type == "IOS_DISTRIBUTION"
        UI.message("Revoking orphaned distribution cert: #{cert.id} (#{cert.display_name})...")
        cert.delete!
      end
    end

    # 2. Generate brand new certificate and private key in the runner keychain
    get_certificates(
      api_key: api_key,
      development: false,
      keychain_path: ENV["KEYCHAIN_PATH"],
      keychain_password: ENV["KEYCHAIN_PASSWORD"]
    )

    # Detect exact signing identity installed in temporary keychain
    identities = sh("security find-identity -v -p codesigning \"#{ENV['KEYCHAIN_PATH']}\"").strip
    UI.message("Keychain identities:\n#{identities}")
    code_sign_id = identities.include?("Apple Distribution") ? "Apple Distribution" : "iPhone Distribution"
    UI.message("Selected CODE_SIGN_IDENTITY: #{code_sign_id}")

    # 3. Generate/fetch provisioning profile linked to the new certificate
    returned_path = get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.patirehber.patiRehber",
      team_id: "J8QM75W7A9",
      development: false,
      force: true
    )

    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH] || returned_path
    profile_uuid = lane_context[SharedValues::SIGH_UUID] || lane_context[SharedValues::SIGH_UDID] || ENV["SIGH_UUID"]
    profile_name = lane_context[SharedValues::SIGH_NAME] || ENV["SIGH_NAME"]

    UI.message("Using profile path=#{profile_path} uuid=#{profile_uuid} name=#{profile_name}")

    # 4. Install provisioning profile into both Xcode <=15 and Xcode 16+ system directories
    sh("mkdir -p \"$HOME/Library/MobileDevice/Provisioning Profiles\"")
    sh("mkdir -p \"$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles\"")
    sh("cp \"#{profile_path}\" \"$HOME/Library/MobileDevice/Provisioning Profiles/#{profile_uuid}.mobileprovision\"")
    sh("cp \"#{profile_path}\" \"$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles/#{profile_uuid}.mobileprovision\"")

    # 5. Update Xcode code signing settings for Runner target (Release only)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "J8QM75W7A9",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      code_sign_identity: code_sign_id,
      bundle_identifier: "com.patirehber.patiRehber",
      targets: ["Runner"],
      build_configurations: ["Release"]
    )

    # 6. Build and archive IPA
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "PatiRehber.ipa",
      clean: false,
      export_options: {
        signingStyle: "manual",
        teamID: "J8QM75W7A9",
        provisioningProfiles: {
          "com.patirehber.patiRehber" => profile_name
        }
      }
    )

    # 7. Upload to App Store Connect / TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/ios/ipa/PatiRehber.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
